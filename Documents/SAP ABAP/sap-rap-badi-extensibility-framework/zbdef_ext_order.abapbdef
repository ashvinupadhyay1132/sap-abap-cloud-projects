managed implementation in class zcl_bp_ext_order unique;
strict ( 2 );

define behavior for ZCDS_I_EXT_ORDER alias ExtOrder
persistent table /dmo/travel
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly ) Order_ID;
  field ( mandatory ) Customer_ID, Gross_Amount;

  /* RAP Determination: Call BAdI interface for custom calculation */
  determination applyBadiDiscount on modify { field Customer_ID, Gross_Amount; }
}
