@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'SD Sales Order Pricing View Entity with Virtual Elements'
@Search.searchable: true

define root view entity ZCDS_I_SALES_PRICING
  as select from /dmo/travel as SalesOrder

  association [0..1] to /DMO/I_Customer as _Customer on $projection.Customer_ID = _Customer.CustomerID
  association [0..1] to I_Currency       as _Currency  on $projection.Currency    = _Currency.Currency
{
  key travel_id       as Sales_Order_ID,
      agency_id       as Sales_Organization,
      customer_id     as Customer_ID,
      begin_date      as Order_Date,
      description     as Order_Reason,

      @Semantics.amount.currencyCode: 'Currency'
      total_price     as Base_List_Price,

      @Semantics.amount.currencyCode: 'Currency'
      booking_fee     as Discount_Percentage,
      currency_code   as Currency,

      /* Virtual Element 1: Calculated Discount Amount */
      @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZCL_CALC_SALES_PRICING'
      @Semantics.amount.currencyCode: 'Currency'
      virtual Discount_Amount : abap.curr(15,2),

      /* Virtual Element 2: Calculated Net GST Tax Amount (18%) */
      @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZCL_CALC_SALES_PRICING'
      @Semantics.amount.currencyCode: 'Currency'
      virtual Net_Tax_Amount : abap.curr(15,2),

      /* Virtual Element 3: Calculated Final Gross Invoice Amount */
      @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZCL_CALC_SALES_PRICING'
      @Semantics.amount.currencyCode: 'Currency'
      virtual Final_Gross_Price : abap.curr(15,2),

      /* Associations */
      _Customer,
      _Currency
}
