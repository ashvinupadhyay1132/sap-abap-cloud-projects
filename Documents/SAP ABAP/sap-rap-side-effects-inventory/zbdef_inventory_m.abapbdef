managed implementation in class zcl_bp_inventory_m unique;
strict ( 2 );

define behavior for ZCDS_I_INVENTORY_M alias Inventory
persistent table /dmo/travel
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly ) Material_ID, Stock_Status, Reorder_Flag;
  field ( mandatory ) Plant_ID, Storage_Location;

  /* Dynamic Instance Feature Control */
  field ( features : instance ) Stock_Quantity;
  action ( features : instance ) reorderStock result [1] $self;

  /* RAP Determination: Recalculate status dynamically when Stock_Quantity is modified */
  determination calculateStockStatus on modify { field Stock_Quantity; }

  /* RAP Validation: Ensure Stock_Quantity is non-negative on save */
  validation validateStockThreshold on save { field Stock_Quantity; }

  association _Bins { create; }
}

define behavior for ZCDS_I_STOCK_ITEM_M alias StorageBin
persistent table /dmo/booking
lock dependent by _Inventory
authorization dependent by _Inventory
{
  update;
  delete;

  field ( readonly ) Material_ID, Bin_ID;

  association _Inventory;
}
