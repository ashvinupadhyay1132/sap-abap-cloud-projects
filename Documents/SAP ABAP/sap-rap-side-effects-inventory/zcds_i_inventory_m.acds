@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Inventory Stock View Entity with Side Effects'
@Search.searchable: true

define root view entity ZCDS_I_INVENTORY_M
  as select from /dmo/travel as InventoryHeader

  composition [0..*] of ZCDS_I_STOCK_ITEM_M as _Bins

  association [0..1] to /DMO/I_Agency as _Plant on $projection.Plant_ID = _Plant.AgencyID
  association [0..1] to I_Currency     as _Currency on $projection.Currency = _Currency.Currency
{
  key travel_id       as Material_ID,
      agency_id       as Plant_ID,
      customer_id     as Storage_Location,
      begin_date      as Last_Movement_Date,
      description     as Material_Description,

      /* Side Effects Annotation: Recalculates Stock_Status when Stock_Quantity changes */
      @Consumption.sideEffects: [ { fieldProperties: { targetFields: ['Stock_Status', 'Reorder_Flag'] } } ]
      booking_fee     as Stock_Quantity,

      @Semantics.amount.currencyCode: 'Currency'
      total_price     as Unit_Standard_Price,
      currency_code   as Currency,

      overall_status  as Stock_Status, " 'O' = Optimal, 'C' = Critical Stock
      currency_code   as Reorder_Flag,  " 'Y' = Reorder Required, 'N' = No Action

      /* Associations */
      _Bins,
      _Plant,
      _Currency
}
