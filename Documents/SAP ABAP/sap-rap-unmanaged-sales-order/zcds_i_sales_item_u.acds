@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Unmanaged Sales Order Item View Entity'

define view entity ZCDS_I_SALES_ITEM_U
  as select from /dmo/booking as SalesItem

  association to parent ZCDS_I_SALES_ORDER_U as _Header on $projection.Sales_Order_ID = _Header.Sales_Order_ID
  association [1..1] to /DMO/I_Customer      as _Customer on $projection.Customer_ID    = _Customer.CustomerID
  association [1..1] to /DMO/I_Carrier       as _Material on $projection.Material_Group = _Material.AirlineID
{
  key travel_id     as Sales_Order_ID,
  key booking_id    as Item_Position,

      booking_date  as Item_Created_Date,
      customer_id   as Customer_ID,
      carrier_id    as Material_Group,
      connection_id as Material_No,
      flight_date   as Delivery_Date,

      @Semantics.quantity.unitOfMeasure: 'Unit_Of_Measure'
      booking_id    as Order_Quantity,
      currency_code as Unit_Of_Measure,

      @Semantics.amount.currencyCode: 'Currency'
      flight_price  as Net_Price,
      currency_code as Currency,

      /* Associations */
      _Header,
      _Customer,
      _Material
}
