unmanaged implementation in class zcl_bp_sales_order_u unique;
strict ( 2 );

define behavior for ZCDS_I_SALES_ORDER_U alias SalesOrder
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly ) Sales_Order_ID;
  field ( mandatory ) Customer_ID, Sales_Org;

  association _Items { create; }
}

define behavior for ZCDS_I_SALES_ITEM_U alias SalesItem
lock dependent by _Header
authorization dependent by _Header
{
  update;
  delete;

  field ( readonly ) Sales_Order_ID, Item_Position;
  field ( mandatory ) Material_No;

  association _Header;
}
