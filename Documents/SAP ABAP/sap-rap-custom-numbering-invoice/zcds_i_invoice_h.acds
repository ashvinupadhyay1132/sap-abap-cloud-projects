@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Invoice Header View Entity - Early Custom Numbering'

define root view entity ZCDS_I_INVOICE_H
  as select from /dmo/travel as InvoiceHeader

  composition [0..*] of ZCDS_I_INVOICE_I as _Items

  association [0..1] to /DMO/I_Customer as _Customer on $projection.Customer_ID = _Customer.CustomerID
  association [0..1] to /DMO/I_Agency   as _Company  on $projection.Company_Code = _Company.AgencyID
  association [0..1] to I_Currency       as _Currency on $projection.Currency     = _Currency.Currency
{
  key travel_id       as Invoice_ID,
      agency_id       as Company_Code,
      customer_id     as Customer_ID,
      begin_date      as Invoice_Date,
      end_date        as Due_Date,
      description     as Billing_Reason,
      overall_status  as Payment_Status,

      @Semantics.amount.currencyCode: 'Currency'
      total_price     as Net_Amount,
      currency_code   as Currency,

      /* Associations */
      _Items,
      _Customer,
      _Company,
      _Currency
}
