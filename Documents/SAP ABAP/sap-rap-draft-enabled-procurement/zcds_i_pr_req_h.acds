@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Draft-Enabled Purchase Requisition Header View Entity'
@Search.searchable: true

define root view entity ZCDS_I_PR_REQ_H
  as select from /dmo/travel as RequisitionHeader

  composition [0..*] of ZCDS_I_PR_REQ_I as _Items

  association [0..1] to /DMO/I_Agency   as _PurchasingOrg on $projection.Purchasing_Org = _PurchasingOrg.AgencyID
  association [0..1] to /DMO/I_Customer as _Vendor        on $projection.Vendor_ID      = _Vendor.CustomerID
  association [0..1] to I_Currency       as _Currency      on $projection.Currency       = _Currency.Currency
{
  key travel_id       as Requisition_ID,
      agency_id       as Purchasing_Org,
      customer_id     as Vendor_ID,
      begin_date      as Requisition_Date,
      end_date        as Required_Delivery_Date,
      description     as Justification,
      overall_status  as Requisition_Status,

      @Semantics.amount.currencyCode: 'Currency'
      total_price     as Total_Estimated_Cost,
      currency_code   as Currency,

      /* Associations */
      _Items,
      _PurchasingOrg,
      _Vendor,
      _Currency
}
