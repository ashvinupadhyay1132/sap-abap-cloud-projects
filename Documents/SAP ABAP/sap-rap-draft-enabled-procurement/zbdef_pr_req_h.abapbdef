managed implementation in class zcl_bp_pr_req_h unique;
strict ( 2 );
with draft;

define behavior for ZCDS_I_PR_REQ_H alias RequisitionHeader
persistent table /dmo/travel
draft table zpr_req_h_d
lock master total etag Requisition_Date
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly ) Requisition_ID;
  field ( mandatory ) Purchasing_Org, Vendor_ID;

  /* Standard Draft Lifecycle Actions */
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  /* Draft Prepare Action executing validations prior to activation */
  draft determine action Prepare
  {
    validation validateVendor;
  }

  validation validateVendor on save { field Vendor_ID; }

  association _Items { create; with draft; }
}

define behavior for ZCDS_I_PR_REQ_I alias RequisitionItem
persistent table /dmo/booking
draft table zpr_req_i_d
lock dependent by _Header
authorization dependent by _Header
{
  update;
  delete;

  field ( readonly ) Requisition_ID, Item_No;

  association _Header { with draft; }
}
