@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: '3-Level Delivery Schedule Line View Entity'

define view entity ZCDS_I_PO_SCHED_3L
  as select from /dmo/booking as POSchedLine

  /* Association to Level 2 Child Parent */
  association to parent ZCDS_I_PO_ITEM_3L as _Item on  $projection.Purchase_Order_ID = _Item.Purchase_Order_ID
                                                    and $projection.Item_Position     = _Item.Item_Position

  /* Association to Level 1 Root Entity */
  association [1..1] to ZCDS_I_PO_HEADER_3L as _Header on $projection.Purchase_Order_ID = _Header.Purchase_Order_ID
{
  key travel_id     as Purchase_Order_ID,
  key booking_id    as Item_Position,
  key booking_id    as Schedule_Line_No,

      flight_date   as Scheduled_Delivery_Date,

      @Semantics.quantity.unitOfMeasure: 'Unit_Of_Measure'
      booking_id    as Scheduled_Quantity,
      currency_code as Unit_Of_Measure,

      currency_code as Delivery_Status,

      /* Associations */
      _Item,
      _Header
}
